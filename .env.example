# LLM: this app uses the Claude Agent SDK, which authenticates through the
# Claude Code CLI's own login (this machine's Claude/Anthropic account and its
# subscription credits) rather than a metered ANTHROPIC_API_KEY. Before running,
# make sure the deployment host has an authenticated Claude Code CLI session
# (run `claude login` once, or provision the equivalent credentials/config the
# CLI expects). No API key belongs in this file.

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
FROM_WHATSAPP_NUMBER=whatsapp:+your_twilio_number

# Google OAuth (credentials.json from Google Cloud Console, "Web application"
# client type — the server uses a callback flow, not a local browser).
# Place credentials.json in the project root; token.json is generated once
# you visit /oauth/google/start after deploying.

# Gmail SMTP (for sending emails)
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Tavily (web search)
TAVILY_API_KEY=your_tavily_api_key

# Supabase / Postgres
DATABASE_URL=postgresql://user:password@host:port/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Server
PORT=5000

# Set to this app's own public HTTPS URL once deployed (no trailing slash),
# e.g. https://your-app.up.railway.app — used to build the exact Google OAuth
# redirect_uri registered in Google Cloud Console.
PUBLIC_BASE_URL=
