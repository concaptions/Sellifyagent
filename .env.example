# LLM: this app uses the Claude Agent SDK. Anthropic's terms do not allow a
# deployed third-party product to ride on a claude.ai/Claude Code account
# login or subscription credits ("Unless previously approved, Anthropic does
# not allow third party developers to offer claude.ai login or rate limits
# for their products, including agents built on the Claude Agent SDK") — a
# real API key from platform.claude.com is required here. The SDK reads it
# automatically from this env var; no other config needed.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
FROM_WHATSAPP_NUMBER=whatsapp:+your_twilio_number

# Google OAuth client (Google Cloud Console, "Web application" client type —
# the server uses a callback flow, not a local browser). No credentials.json
# file needed: the client config is built from these two values directly.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# token.json is generated once you visit /oauth/google/start after deploying.
# Point this at a mounted persistent volume's path if your host's filesystem
# is otherwise ephemeral (e.g. /data/token.json) so a redeploy doesn't lose it.
GOOGLE_TOKEN_FILE=token.json
# Reading AND sending Gmail both go through this same OAuth connection (the
# gmail.readonly and gmail.send scopes above) — no separate SMTP credential
# needed. An earlier version of this app sent mail over SMTP with a
# GMAIL_ADDRESS/GMAIL_APP_PASSWORD pair, which is a second Google credential
# to keep valid alongside the OAuth one and fails outright (535) if that
# value isn't a real 16-character Google App Password.

# Tavily (web search)
TAVILY_API_KEY=your_tavily_api_key

# Supabase / Postgres
DATABASE_URL=postgresql://user:password@host:port/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Server
PORT=5000

# Set to this app's own public HTTPS URL once deployed (no trailing slash),
# e.g. https://your-app.up.railway.app — used to build the exact Google OAuth
# redirect_uri registered in Google Cloud Console.
PUBLIC_BASE_URL=
